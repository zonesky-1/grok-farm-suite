[Unit]
Description=Syad Grok Farm Turbo (12 worker)
After=network-online.target

[Service]
Type=simple
User=ubuntu
Slice=syadagentic.slice
Environment=DISPLAY=:99
ExecStart=/bin/bash /home/ubuntu/farm/grok_sb2_turbo.sh
Restart=always
RestartSec=10
Nice=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
